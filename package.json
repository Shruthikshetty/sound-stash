{
  "name": "sound-stash",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:webapp": "bun --filter backend --filter web dev",
    "dev:backend": "bun --filter backend dev",
    "dev:web": "bun --filter web dev",
    "deploy:backend": "bun --filter backend deploy",
    "cf-typegen:backend": "bun --filter backend cf-typegen",
    "db:generate": "bun --filter backend db:generate",
    "db:migrate:local": "bun --filter backend db:migrate:local",
    "db:migrate:prod": "bun --filter backend db:migrate:prod",
    "generate-http-status-codes": "bun scripts/generate-http-status-codes.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
